# Remove all existing dynamic partitions and groups before applying full OTA
remove_all_groups
# Add group samsung_dynamic_partitions
add_group samsung_dynamic_partitions 0000000000
# Add partition system to group samsung_dynamic_partitions
add system samsung_dynamic_partitions
# Add partition vendor to group samsung_dynamic_partitions
add vendor samsung_dynamic_partitions
# Add partition product to group samsung_dynamic_partitions
add product samsung_dynamic_partitions
# Add partition odm to group samsung_dynamic_partitions
add odm samsung_dynamic_partitions
# Grow partition system
resize system 0000000000
# Grow partition vendor
resize vendor 000000000
# Grow partition product
resize product 0000000000
# Grow partition odm
resize odm 0000000
